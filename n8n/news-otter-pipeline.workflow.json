      {
        "parameters": {
          "jsCode": "const sd=$getWorkflowStaticData('global');\nconst blocks=$input.first().json.blocks||[];\nconst nowSec=Math.floor(Date.now()/1000);\nlet mx = sd.postsSince ?? 0;\nlet pick=null;\nfor(const b of blocks){\n  if(b.block_start>mx) mx=b.block_start;             // advance cursor past ALL seen\n  if(b.block_start < nowSec-7200) continue;           // stale (>2h): never upload\n  if(!pick || b.block_start>pick.block_start) pick=b; // keep ONLY the freshest block\n}\nif(blocks.length) sd.postsSince=mx;\nif(!pick) return [];                                  // nothing current to post\nconst slot = DateTime.now().setZone('America/Chicago').toFormat('yyyyLLdd-HHmm');\nreturn [{json:{\n  block_start:pick.block_start,\n  text:pick.script||pick.news_script||'',\n  title:pick.title||pick.news_title||'The News Otter',\n  caption:pick.caption||pick.news_caption||pick.news_caption_tts||pick.title||'The News Otter',\n  media_type:'REELS',\n  slug:'REELS_'+slot                                // name the clip for its upload slot\n}}];"
        },
