      "typeVersion": 2,
      "position": [
        752,
        -192
      ]
    },
    {
      "parameters": {
        "url": "=https://jafo.live/api/news/posts?block=30m&full=1&since={{ $json.since }}",
        "options": {}
      },
      "id": "67ce9642-750c-4370-bb45-a402b924250e",
      "name": "Fetch Posts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        976,
        -192
      ]
    },
    {
      "parameters": {
        "jsCode": "const sd=$getWorkflowStaticData('global');\nconst blocks=$input.first().json.blocks||[];\nlet mx = sd.postsSince ?? 0;\nconst out=[];\nfor(const b of blocks){\n  if(b.block_start>mx) mx=b.block_start;\n  out.push({json:{\n    block_start:b.block_start,\n    text:b.news_script||b.script||'',\n    title:b.news_title||b.title||'The News Otter',\n    caption:b.news_caption||b.news_caption_tts||b.title||'The News Otter',\n    media_type:'REELS'\n  }});\n}\nif(blocks.length) sd.postsSince=mx;   // advance only when we actually got blocks\nreturn out;"
      },
      "id": "2121a5f1-7492-46ec-8221-32cee93c709e",
      "name": "Normalize Posts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        -192
      ]
    },
    {
      "parameters": {
        "formTitle": "News Otter \u2014 Test Transmission",
        "formDescription": "Pick a type and run a test render+post.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Type",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Post"
                  },
                  {
                    "option": "Story"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Script",
              "fieldType": "textarea",
              "placeholder": "Leave blank to use sample text"
            }
          ]
        },
        "options": {}
      },
      "id": "888a3d92-f6d1-4e31-aa29-79a28546eb8b",
      "name": "Test Trigger",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        512,
        0
      ],
      "webhookId": "45bb5442-b9be-4dcf-8af0-3220c447d9e7"
    },
    {
      "parameters": {
        "jsCode": "const f=$input.first().json;\nconst type=f.Type||f.type||'Post';\nconst isStory=String(type).toLowerCase().startsWith('s');\nconst script=(f.Script||'').trim() || (isStory\n  ? 'Here is what is moving across the Valley this block. McAllen crews handled a medical call and a minor traffic incident. This is a test story digest.'\n  : \"Good evening, I'm the News Otter, and these are the stories making waves tonight. This is a test broadcast.\");\nreturn [{json:{\n  text: script,\n  title: isStory ? '\\ud83d\\udea8 Test Digest: Valley Roundup' : 'Test Broadcast',\n  caption: isStory ? 'A test roundup of Valley activity this block. \\ud83d\\ude4f #RGVNews #Test' : 'Test broadcast \\ud83e\\udda6 #TheNewsOtter #Test',\n  media_type: isStory ? 'STORIES' : 'REELS'\n}}];"
      },
      "id": "fb8eda48-da63-4af4-98dd-5b789fa88c55",
      "name": "Build Test",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        752,
        0
      ]
    },
    {
      "parameters": {
        "method": "DELETE",
        "url": "=http://127.0.0.1:8000/video/{{ $('Render Submit').item.json.job_id }}",
        "options": {}
