        160
      ]
    },
    {
      "parameters": {},
      "id": "43bc9266-89ee-4f0a-92c0-e0adbdf67afb",
      "name": "Backfill Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        752,
        896
      ]
    },
    {
      "parameters": {
        "url": "https://jafo.live/api/news?full=1",
        "options": {}
      },
      "id": "5d337dc7-e305-46e7-8a72-bf3dcf2a055c",
      "name": "Fetch All Stories",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        976,
        896
      ]
    },
    {
      "parameters": {
        "jsCode": "// Backfill: grab the most recent stories and run them through the FULL pipeline (render + post).\nconst list = ($input.first().json.stories || []).slice();\nlist.sort((a,b)=>(b.created_at||0)-(a.created_at||0));   // newest first\nconst LIMIT = 3;   // <-- set how many of the latest stories to process. Use list.length for ALL.\nreturn list.slice(0, LIMIT).map(s => ({\n  json: {\n    id: s.id,\n    title: s.news_title || s.title || 'The News Otter',\n    caption: s.news_caption || s.news_title || s.title || 'The News Otter',\n    script: s.news_script || ''\n  }\n}));"
      },
      "id": "49bf150e-db33-44ca-b403-10584a7cd51b",
      "name": "Take Last N",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        896
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 20
            }
          ]
        }
      },
      "id": "08c85777-7682-4ddc-82cf-c2d1eca4d10e",
      "name": "Stories Every 20m",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        528,
        -400
      ]
    },
    {
      "parameters": {
        "jsCode": "const sd=$getWorkflowStaticData('global');\nif(sd.storiesSince==null) sd.storiesSince=Math.floor(Date.now()/1000)-1200;  // first run: last block\nreturn [{json:{since: sd.storiesSince}}];"
      },
      "id": "2e5ac796-ede9-45b5-8d74-65dba93003ae",
      "name": "Stories Since",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        752,
        -400
      ]
    },
    {
      "parameters": {
        "url": "=https://jafo.live/api/news/stories?block=20m&full=1&since={{ $json.since }}",
        "options": {}
      },
      "id": "10f13120-fc30-4169-9641-26d6f468322e",
      "name": "Fetch Stories",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        976,
        -400
      ]
    },
    {
      "parameters": {
        "jsCode": "const sd=$getWorkflowStaticData('global');\nconst blocks=$input.first().json.blocks||[];\nlet mx = sd.storiesSince ?? 0;\nconst out=[];\nfor(const b of blocks){\n  if(b.block_start>mx) mx=b.block_start;\n  out.push({json:{\n    block_start:b.block_start,\n    text:b.script||b.news_script||'',\n    title:b.news_title||b.title||'The News Otter',\n    caption:b.caption||b.news_caption||b.title||'The News Otter',\n    media_type:'STORIES'\n  }});\n}\nif(blocks.length) sd.storiesSince=mx;   // advance only when we actually got blocks\nreturn out;"
      },
      "id": "533b1ecf-46cb-428f-a6d7-1f332ca56227",
      "name": "Normalize Stories",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        -400
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 30
            }
          ]
        }
      },
      "id": "a08d8d39-9a4a-4659-b40e-ca961ab0c755",
      "name": "Posts Every 30m",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        528,
        -192
      ]
    },
    {
      "parameters": {
        "jsCode": "const sd=$getWorkflowStaticData('global');\nif(sd.postsSince==null) sd.postsSince=Math.floor(Date.now()/1000)-1800;  // first run: last block\nreturn [{json:{since: sd.postsSince}}];"
      },
      "id": "621c62d7-e650-42dc-b1c1-2bd9fd160e81",
      "name": "Posts Since",
