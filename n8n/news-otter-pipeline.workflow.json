    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8000/render",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"text\": {{ JSON.stringify(($json.body && $json.body.script) ? $json.body.script : ($json.text || $json.script)) }},\n  \"title\": {{ JSON.stringify($json.title || \"The News Otter\") }},\n  \"caption\": {{ JSON.stringify($json.caption || $json.title || \"The News Otter\") }},\n  \"media_type\": {{ JSON.stringify($json.media_type || \"REELS\") }}\n}",
        "options": {}
      },
      "id": "b1655e25-379e-48af-afe0-2d3dce823c28",
