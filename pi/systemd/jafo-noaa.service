[Unit]
Description=jafo — NOAA Weather Radio SAME alert monitor (RTL; NOAA mode only)
After=network-online.target
Wants=network-online.target
# Not enabled by default — the RTL is shared. Use scripts/sdr-mode.sh noaa.
Conflicts=readsb.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/jafo-data
EnvironmentFile=/home/pi/jafo/.env
Environment=JAFO_DATA_DIR=/home/pi/jafo-data
ExecStart=/home/pi/jafo-data/venv-services/bin/python /home/pi/jafo/pi/services/noaa.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
Nice=5
OOMScoreAdjust=100
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
