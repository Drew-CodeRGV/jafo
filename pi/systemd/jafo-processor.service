[Unit]
Description=jafo — processor (VAD filter + Opus + SQLite)
After=jafo-recorder.service
Wants=jafo-recorder.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/jafo-data
EnvironmentFile=/home/pi/jafo/.env
Environment=JAFO_DATA_DIR=/home/pi/jafo-data
ExecStart=/home/pi/jafo-data/venv-services/bin/python /home/pi/jafo/pi/services/processor.py
Restart=on-failure
RestartSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
