[Unit]
Description=jafo — ACARS uploader (pushes decoded ACARS to central hub)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/jafo-data
EnvironmentFile=/home/pi/jafo/.env
Environment=JAFO_DATA_DIR=/home/pi/jafo-data
Environment=PYTHONPATH=/home/pi/jafo/pi/services
ExecStart=/home/pi/jafo-data/venv-services/bin/python /home/pi/jafo/pi/services/acars_upload.py
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal
Nice=10
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
