[Unit]
Description=Ollama local LLM server
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=pi
Environment=HOME=/home/pi
Environment=PATH=/home/pi/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Bind only to localhost — jafo-enricher talks to it from the same host
Environment=OLLAMA_HOST=127.0.0.1:11434
# Keep one model loaded at a time; Pi 5 has finite RAM
Environment=OLLAMA_MAX_LOADED_MODELS=1
Environment=OLLAMA_NUM_PARALLEL=1
# Stash models in the user's home so they survive reinstalls
Environment=OLLAMA_MODELS=/home/pi/.ollama/models
ExecStart=/home/pi/.local/bin/ollama serve
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal
Nice=15
# ollama is the FIRST thing the kernel kills under memory pressure —
# we'd rather lose a transient LLM call than the capture pipeline
OOMScoreAdjust=800
MemoryHigh=2G
MemoryMax=2.5G
TimeoutStopSec=20
# Strict CPU subordination: when trunk-recorder, faster-whisper, or the
# processor want CPU, they get it. ollama only runs when there's slack.
# CPUWeight default is 100; 20 makes ollama lowest-priority among jafo.
CPUWeight=20
CPUSchedulingPolicy=batch
IOWeight=50
# Keep the model resident in RAM so inference latency is consistent
# (re-loading on every request would compound the slowness). 30 min is
# longer than any reasonable lull between calls during active hours.
Environment=OLLAMA_KEEP_ALIVE=30m

[Install]
WantedBy=multi-user.target
