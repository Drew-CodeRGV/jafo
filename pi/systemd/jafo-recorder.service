[Unit]
Description=jafo — trunk-recorder P25 capture
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=plugdev
WorkingDirectory=/home/pi/jafo-data
ExecStart=/usr/local/bin/trunk-recorder --config=/home/pi/jafo-data/config/config.json
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
Nice=-5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
