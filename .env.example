# jafo configuration
# Edit any value and restart the relevant service to apply.

# Friendly node name (used in logs, useful for multi-Pi setups)
JAFO_NODE_NAME=jafo-mcallen-01

# How many days to keep filtered audio locally (DB rows kept forever)
AUDIO_RETENTION_DAYS=30

# === API keys ===
# Get from https://console.groq.com — Whisper transcription
GROQ_API_KEY=

# Get from https://console.anthropic.com — incident enrichment
ANTHROPIC_API_KEY=

# === Web service ===
# Bind address for Flask (0.0.0.0 = listen on all interfaces)
JAFO_WEB_HOST=127.0.0.1
JAFO_WEB_PORT=8080

# === Geographic context for enrichment prompts ===
# Helps Claude correctly geocode addresses ("10th and Pecan" → which city?)
# IMPORTANT: quote the value if it contains commas or spaces, or sourcing will break.
JAFO_REGION="McAllen, Hidalgo County, Texas"
